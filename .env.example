# Copy this to .env and fill in. NEVER commit the real .env — see .gitignore.
#
# These are the same variable names the Spring Boot backend uses for its
# writer datasource (DB_ENDPOINT_WRITER / DB_USERNAME_WRITER / DB_PASSWORD_WRITER),
# so you can point this at your local dev DB, a staging DB, or production by
# changing only this file — never the code.
#
# For a first test run, point this at your LOCAL dev database, not production.

DB_ENDPOINT_WRITER=localhost
DB_PORT=5432
DB_NAME=tradecraft_database
DB_USERNAME_WRITER=postgres
DB_PASSWORD_WRITER=
